# Daraja environment: sandbox or production
DARAJA_ENV=sandbox

# Copy credentials from the matching Safaricom Daraja app.
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

# Select CustomerPayBillOnline or CustomerBuyGoodsOnline for your shortcode.
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Use a public HTTPS callback URL, for example through your approved tunnel.
# The final path segment must exactly match DARAJA_CALLBACK_TOKEN.
DARAJA_CALLBACK_TOKEN=replace-with-a-random-secret-at-least-32-characters
DARAJA_CALLBACK_URL=https://your-public-host.example/api/mpesa/callback/replace-with-a-random-secret-at-least-32-characters

# Local POS server defaults; keep it bound to loopback unless your deployment
# has server-side authentication and a TLS reverse proxy configured.
HOST=127.0.0.1
PORT=3000
