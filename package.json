{
  "name": "tajiri-pos",
  "version": "1.0.0",
  "description": "Tajiri POS — sales, stock, staff, and shop management for retail businesses.",
  "author": "Tajiri POS",
  "license": "MIT",
  "main": "electron/main.js",
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2",
    "vercel": "^64.5.0",
    "vitest": "^5.0.4"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "start:php": "php -S 127.0.0.1:8000 php-server.php",
    "electron:dev": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "test": "vitest run"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "electron-builder@26.15.3": true,
    "esbuild@0.27.0": true,
    "electron-winstaller@5.4.0": true
  },
  "build": {
    "appId": "com.tajiri.pos",
    "productName": "Tajiri POS",
    "compression": "maximum",
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "index.html",
      "main.html",
      "login.html",
      "admin.html",
      "cashier.html",
      "app.js",
      "welcome.js",
      "styles.css",
      "welcome.css",
      "offline-db.js",
      "supabase-shim.js",
      "manifest.webmanifest",
      "icons/**",
      "electron/main.js"
    ],
    "win": {
      "target": "nsis",
      "icon": "icons/tajiri-pos-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "TajiriPOSSetup-${version}.${ext}"
    }
  }
}
